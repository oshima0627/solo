{
  "name": "solo",
  "version": "0.0.0",
  "private": true,
  "description": "沖縄のトランプゲーム「ソロ」のWebアプリ",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @solo/web",
    "build": "npm run build -w @solo/web",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "cap:sync": "npm run build && node scripts/strip-unused-fonts.mjs && npx cap sync android",
    "android": "npm run cap:sync && npx cap open android",
    "assets:android": "node scripts/generate-android-assets.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "glob": "^13.0.6",
    "sharp": "^0.35.3"
  }
}
